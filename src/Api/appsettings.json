{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hek-core-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "ConnectionStrings": {
    "TenantRegistry": "Server=localhost,1433;Database=HekTenantRegistry;User Id=sa;Password=CHANGE_ME_DEV_ONLY;TrustServerCertificate=True;"
  },
  "Auth": {
    "Enabled": false,
    "SigningKeySecretName": "Auth:JwtSigningKey",
    "TokenExpiryHours": 12
  },
  "Auth:JwtSigningKey": "DEV-ONLY-INSECURE-SIGNING-KEY-REPLACE-VIA-SECRET-PROVIDER-0000000000",
  "HisoSession": {
    "ExpiryHours": 12
  },
  "HisoServerAddressMap": {
    "Addresses": {}
  },
  "RateLimit": {
    "Enabled": false,
    "PermitLimit": 10000,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173", "https://localhost:3000", "http://localhost:5173", "http://localhost:5174" ]
  },
  "LegacyDms": {
    "DocumentTypes": "",
    "SqlCommandTimeoutSeconds": 30
  },
  "TaskStatus": {
    "ActiveStatusId": "1",
    "CompletedStatusId": "2"
  },
  "LegacyHostRouting": {
    "// comment": "v1.1 spec Step 2: real per-environment hostname -> which system's /api or /COL path this is. Add a rule per real environment domain as they're confirmed; unmatched hosts fall through unchanged.",
    "Rules": [
      { "HostContains": "hss", "System": "Karo" },
      { "HostContains": "erms", "System": "Erms" },
      { "HostContains": "col", "System": "Col" }
    ]
  },
  "Legacy:ConnMHNPMS": "Server=localhost,1433;Database=CHANGE_ME_LegacyPMS;User Id=sa;Password=CHANGE_ME_DEV_ONLY;TrustServerCertificate=True;",
  "Legacy:ConnMHNDMS": "Server=localhost,1433;Database=CHANGE_ME_LegacyDMS;User Id=sa;Password=CHANGE_ME_DEV_ONLY;TrustServerCertificate=True;",
  "Legacy:DbCredentials:localhost": "User Id=sa;Password=CHANGE_ME_DEV_ONLY"
}
