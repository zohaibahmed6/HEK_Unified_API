{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hek-core-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "ConnectionStrings": {
    "TenantRegistry": "Server=localhost,1433;Database=HekTenantRegistry;User Id=sa;Password=CHANGE_ME_DEV_ONLY;TrustServerCertificate=True;"
  },
  "Auth": {
    "Enabled": false,
    "SigningKeySecretName": "Auth:JwtSigningKey",
    "TokenExpiryHours": 12
  },
  "Auth:JwtSigningKey": "DEV-ONLY-INSECURE-SIGNING-KEY-REPLACE-VIA-SECRET-PROVIDER-0000000000",
  "HisoSession": {
    "ExpiryHours": 12
  },
  "HisoServerAddressMap": {
    "Addresses": {}
  },
  "RateLimit": {
    "Enabled": false,
    "PermitLimit": 10000,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5173", "https://localhost:3000" ]
  }
}
