<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Explicit override forcing a newer patch than EF Core 8.0.10 pulls transitively (5.2.0) - see
         Directory.Packages.props for why. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="PdfSharp" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <!-- v1.1 spec follow-through Step 5: real AWSDoc.IndiciDMS, supplied by Zohaib (confirmed
         .NETCoreApp,Version=v8.0 native, no compat shim needed) - see Legacy/Hiso/vendor/README. -->
    <Reference Include="AWSDocCore">
      <HintPath>Legacy\Hiso\vendor\AWSDocCore.dll</HintPath>
    </Reference>
    <!-- PROJECT_STATUS.md item 30 resolved (2026-07-26): the real Aspose.Words.dll + Aspose.Words.lic
         Zohaib supplied were sitting in legacy-reference/Hiso/bin the whole time - the earlier
         "no license available" framing was stale/wrong, same mistake as the AWSDocCore gap. Confirmed
         working under net8.0 via a scratch probe (real license load + Document->PDF render succeeded)
         with System.Text.Encoding.CodePages + System.Drawing.Common as the only two extra shims a
         .NET Framework 4.0 assembly needs under .NET 8. -->
    <Reference Include="Aspose.Words">
      <HintPath>Legacy\Hiso\vendor\Aspose.Words.dll</HintPath>
    </Reference>
    <None Include="Legacy\Hiso\vendor\Aspose.Words.lic" Link="Aspose.Words.lic" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\HekCoreApi.Application.csproj" />
    <ProjectReference Include="..\Domain\HekCoreApi.Domain.csproj" />
    <ProjectReference Include="..\Contracts\HekCoreApi.Contracts.csproj" />
  </ItemGroup>

</Project>
