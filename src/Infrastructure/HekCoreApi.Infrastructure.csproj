<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Static Log.Logger, used by LegacyDbExecutor to log every SP call centrally regardless of
         caller (no ILogger<T> DI available in that static class) - configured/set once in Api's
         Program.cs via UseSerilog, so this just needs the core abstraction, not Serilog.AspNetCore. -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Explicit override forcing a newer patch than EF Core 8.0.10 pulls transitively (5.2.0) - see
         Directory.Packages.props for why. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Explicit override to force resolution to a patched build (see Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="PdfSharp" />
    <!-- Used by AsposeMimeConverter.ConvertImageToPdfAsync in place of Aspose.Words -
         cross-platform image decode, paired with PdfSharp to draw the image onto a PDF page. -->
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- Official Aspose.Words NuGet package (net10-compatible, replaces the old vendored net40
         Aspose.Words.dll) for AsposeMimeConverter.ConvertHtmlToPdfAsync - see
         Directory.Packages.props for the license status. -->
    <PackageReference Include="Aspose.Words" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <!-- v1.1 spec follow-through Step 5: real AWSDoc.IndiciDMS, supplied by Zohaib (confirmed
         .NETCoreApp,Version=v8.0 native, no compat shim needed) - see Legacy/Hiso/vendor/README. -->
    <Reference Include="AWSDocCore">
      <HintPath>Legacy\Hiso\vendor\AWSDocCore.dll</HintPath>
    </Reference>
    <!-- Old vendored net40 Aspose.Words.dll <Reference> removed 2026-08-03 (its license failed to
         load under net10 - root cause unconfirmed, inside Aspose's closed-source code, see
         MIGRATION_STATUS.md) - replaced by the official Aspose.Words NuGet PackageReference above.
         The .lic file itself is still copied: it's expired against this newer Aspose.Words version
         (confirmed live - "allows free upgrades until 20 Apr 2017, but this version was released
         01 Nov 2024"), so AsposeMimeConverter currently runs unlicensed/evaluation (Zohaib's call,
         2026-08-03 - watermarked PDFs, revisit once a current license exists). Drop a renewed
         Aspose.Words.lic at this same path to pick up a real license with no further code changes. -->
    <None Include="Legacy\Hiso\vendor\Aspose.Words.lic" Link="Aspose.Words.lic" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\HekCoreApi.Application.csproj" />
    <ProjectReference Include="..\Domain\HekCoreApi.Domain.csproj" />
    <ProjectReference Include="..\Contracts\HekCoreApi.Contracts.csproj" />
  </ItemGroup>

</Project>
