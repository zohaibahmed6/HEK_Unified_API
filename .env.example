# Copy to .env and fill in real values. Never commit the real .env file (see .gitignore).
# Direct replacement for the hardcoded 'tcpepms*1' pattern found in all three legacy systems -
# every secret here is resolved at runtime via ISecretProvider, never a literal in code.

SA_PASSWORD=Replace_With_A_Strong_Local_Dev_Password1!
AUTH_ENABLED=false
AUTH_JWT_SIGNING_KEY=Replace_With_A_Long_Random_Local_Dev_Only_Signing_Key

# Entra ID (ADR-002) - only required once Auth__Enabled=true and a real tenant/App Registration exists.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
