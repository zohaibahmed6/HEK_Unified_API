            "body": { "mode": "raw", "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<ReferralDocument>\n<ReferralDocument_Referral_ID>1</ReferralDocument_Referral_ID>\n<ReferralDocument_Document_ID>1001</ReferralDocument_Document_ID>\n<ReferralDocument_Patient_PMS_ID>2450776</ReferralDocument_Patient_PMS_ID>\n<ReferralDocument_Encounter_ID>19592581__901__FZZ999-B</ReferralDocument_Encounter_ID>\n<ReferralDocument_Referral_Type>Specialist Referral</ReferralDocument_Referral_Type>\n<ReferralDocument_Item_Type>in</ReferralDocument_Item_Type>\n<ReferralDocument_Referral_Status>New</ReferralDocument_Referral_Status>\n<ReferralDocument_Created_Date>2026-07-31</ReferralDocument_Created_Date>\n<ReferralDocument_Referrer_Fullname>Test Referrer</ReferralDocument_Referrer_Fullname>\n<ReferralDocument_Referrer_PMS_ID>2450776</ReferralDocument_Referrer_PMS_ID>\n<ReferralDocument_Document_Source>Manual verification</ReferralDocument_Document_Source>\n<ReferralDocument_Content_Type>application/pdf</ReferralDocument_Content_Type>\n<ReferralDocument_Description_Type>Referral</ReferralDocument_Description_Type>\n<ReferralDocument_Description>Manual verification document</ReferralDocument_Description>\n<ReferralDocument_Encoding>base64</ReferralDocument_Encoding>\n<ReferralDocument_Content>SGVsbG8gV29ybGQ=</ReferralDocument_Content>\n<ReferralDocument_Error_Text></ReferralDocument_Error_Text>\n</ReferralDocument>" },
