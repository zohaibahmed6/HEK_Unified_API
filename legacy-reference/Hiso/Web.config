<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Hiso.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.6"/>
  </system.web>
  <system.serviceModel>
    <!-- Service Behaviors-->
    <behaviors>
      <serviceBehaviors>
        <behavior name="HisoSessionBehavior">
          <serviceMetadata httpGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
          <useRequestHeadersForMetadataAddress/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <!-- Bindings-->
    <bindings>
      <basicHttpBinding>
        <binding name="FormSessionSoapBinding" closeTimeout="00:01:00" openTimeout="00:01:00" receiveTimeout="00:10:00" sendTimeout="00:01:00" allowCookies="false" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" maxBufferSize="2147483647" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" messageEncoding="Text" textEncoding="utf-8" transferMode="Buffered" useDefaultWebProxy="true">
          <readerQuotas maxDepth="32" maxStringContentLength="2147483647" maxArrayLength="16384" maxBytesPerRead="4096" maxNameTableCharCount="16384"/>
          <security mode="None">
            <transport clientCredentialType="None" proxyCredentialType="None" realm=""/>
            <message clientCredentialType="UserName" algorithmSuite="Default"/>
          </security>
        </binding>
      </basicHttpBinding>
    </bindings>
    <!-- Addressing-->
    <services>
      <service name="Hiso.FormSessionService" behaviorConfiguration="HisoSessionBehavior">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="FormSessionSoapBinding" contract="FormSessionPortType" name="FormSessionPort">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <!--<endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>-->
      </service>
    </services>
  </system.serviceModel>
  <system.webServer>
    <!--<modules runAllManagedModulesForAllRequests="true"/>-->
    <!--
        To browse web app root directory during debugging, set the value below to true.
        Set to false before deployment to avoid disclosing web app folder information.
      -->
    <directoryBrowse enabled="true"/>
    <modules>
      <remove name="ServiceModel"/>
    </modules>
  </system.webServer>
  <connectionStrings>
    <!--<add name="ConectionStringPMS_NZ" connectionString="Data Source=dbserver\sql2014;Initial Catalog=pms_nz;uid=pms_nz;password=pms@@nz;" providerName="System.Data.SqlClient"/>-->
    <!--<add name="ConectionStringPMS_NZ" connectionString="Data Source=dbserver\sql2014;Initial Catalog=PMS_NZ;uid=pms_nz;password=pms@@nz;" providerName="System.Data.SqlClient"/>-->
    <add name="ConectionStringPMS_NZ" connectionString="Data Source=dbserver-local;Initial Catalog=PMS_NZ_V2;User ID=pms_nz;Password=pms@@nz;" providerName="System.Data.SqlClient"/>
    <add name="ConectionStringPMS_NZ_SecondNode" connectionString="Data Source=dbserver-local;Initial Catalog=PMS_NZ_V2;User ID=pms_nz;Password=pms@@nz;" providerName="System.Data.SqlClient"/>
    <add name="ConectionStringIndici_Master" connectionString="Data Source=192.168.0.6\sql2014;Initial Catalog=Indici_Master;uid=pms_nz;password=pms@@nz;" providerName="System.Data.SqlClient"/>
    <add name="ConectionStringPMS_NZ_DMS" connectionString="Data Source=dbserver-local;Initial Catalog=DMS_PMS;User ID=pms_nz;Password=pms@@nz;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
	  <add key="ConectionStringPMS_NZ" value="Data Source=dbserver-local;Initial Catalog=PMS_NZ_V2;User ID=pms_nz;Password=pms@@nz;" />
	  <add key="DMSServer" value="Data Source=dbserver-local;Initial Catalog=DMS_PMS;User ID=pms_nz;Password=pms@@nz;" />

	  <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true"/>
    <add key="LogRoot" value="D:\Publish"/>
    <add key="SoapMessageLogRoot" value="C:\Logs\soapmessages.txt"/>
    <add key="SubmissionURL" value=""/>
    <add key="UserID" value="utyl3chd"/>
    <add key="addDMSRef" value="1"/>
    <add key="Password" value="1"/>
    <!--<add key ="URL" value ="http://quantum.spectrumpms.nz:5088/SubmissionGateway"/>-->
    <add key="URL" value=""/>
    <add key="htmlPath" value="D:\Projects\HISO-ServiceProject\Hiso\Hiso\data\SubmittedData\"/>
    <!--P= Production, T=Test Mode-->
    <add key="Mode" value="T"/>
    <!--DocumentType-->
    <add key="DMSHTMLTypeId" value="11"/>
    <add key="DMSPDFTypeId" value="1"/>
    <add key="DMSServiceURL" value="http://192.168.0.157/DMSService/ClientService.asmx"/>
    <!--Task related -->
    <add key="ACC45TaskTypeTypeId" value="5"/>
    <add key="TaskPriorityId" value="1"/>
    <add key="TaskStatusActive" value="2"/>
    <add key="TaskStatusCompleted" value="4"/>
    <add key="PracticeEDI" value="1"/>
    <!--Procare and Compass-->
    <!-- UDTColumn -->
    <add key="UDT_tblACC45Definition" value="ACC45ID,AppointmentID,PatientID,ProviderID,FormInstanceID,FormInstanceVersion,FormEngineID,FormInstanceCreationDate,FormInstanceOperationMode,FormInstanceDescription,FormDefinitionId,FormDefinitionVersion,FormDefinitionDescription,FormDefinitionTitle,RecipientAccount,ViewType,ViewSignature,ResumePath,DMSDocumentID,IsActive,IsDeleted,InsertedBy,UpdatedBy,InsertedAt,UpdatedAt"/>
    <add key="UDT_tblACC45Detail" value="ACC45ID,ACC45Number,AccidentDate,AccidentTime,AccidentISWPA,AccidentMotorVehicle,AccidentMedicalMisadventure,ACC45StatusID,ACC45StatusDate,CauseOfInjury,AccidentLocation,AccidentLocationCode,SceneCode,SceneDescription,Comments,OccupationACCCode,OccupationDescription,UsualWorkType,EmploymentStatus,EmploymentStatusDescription,EmployerOrganisationName,EmployerOrganisationAddress,InsurerName,IsInNZ,IsWorkedRelated,IsMotorVehicleRelated,IsGradualInjury,IsMisadventure,SportCode,FitForWork,FullIncapacityStartDate,FullIncapacityEndDate,FullIncapacityPeriod,PartialIncapacityStartDate,PartialIncapacityEndDate,PartialIncapacityHours,PartialIncapacityPeriod,WorkRestrictions,WorkRestrictionsComments,RectrictionProlongedStanding,RestrictionProlongedSitting,RestrictionProlongedWalking,RestrictionDriving,RestrictionPosture,RestrictionRepetition,RestrictionLiftingForcefulMovements,RestrictionHeavyPhysicalWork,RestrictionTemperature,RestrictionVibration,RestrictionOther,InboxFolderItemID,PracticeID,IsContactACC,WorkRestrictionsType"/>
    <add key="UDT_tblPatient" value="ReferenceId,Patient_FirstName,Patient_Surname,Patient_DateOfBirth,Patient_Gender,Patient_Ethnicity1CodeLevel2,Patient_ResidentialAddress_StreetName,Patient_ResidentialAddress_City"/>
    <add key="UDT_tblPatientConsult" value="ReferenceId,Patient_Consult_Date,Patient_Consult_Notes,Patient_Consult_History,Patient_Consult_Exam,Patient_Consult_Diagnosis,Patient_Consult_Actions,Patient_Consult_PresentingComplaint"/>
    <add key="UDT_tblPatientEmployerOrganisation" value="PatientEmployerOrganisation_Name,Patient_Occupation_Description,Patient_OccupationACCCode,PatientEmployerOrganisation_PhysicalAddress_StreetNumber,PatientEmployerOrganisation_PhysicalAddress_StreetName,PatientEmployerOrganisation_PhysicalAddress_AdditionalLine,PatientEmployerOrganisation_PhysicalAddress_Suburb,PatientEmployerOrganisation_PhysicalAddress_City,PatientEmployerOrganisation_PhysicalAddress_Postcode,PatientEmployerOrganisation_PhysicalCountry,PatientEmployerOrganisation_GeocodeXCoordinate,PatientEmployerOrganisation_GeocodeYCoordinate"/>
    <add key="UDT_tblPatientProblem" value="DiagnosisID,Patient_Problem_Description,Patient_Problem_Code,Patient_Problem_DateRecorded,Patient_Problem_Author_Application_UserID"/>
    <add key="UDT_tblRegisteredPractitioner" value="ReferenceId,RegisteredPractitioner_FullName"/>
    <add key="IsDynamic" value="1"/>
    <add key="QualifierList" value="271649006,271650006,75367002,27113001,50373000,60621009,14647-2,14646-4,14927-8,39469-2,14682-9,14959-1,33914-3,4548-4,59261-8,XNZ0436,73211009,46635009,44054006,99006,6W,3M,5M,15M,11Y"/>
    <add key="DMSServer" value="Data Source=192.168.0.6\sql2014;Initial Catalog=DMS_PMS;User ID=pms_nz;Password=pms@@nz"/>
    <add key="AddDirectDMS" value="1"/>
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>